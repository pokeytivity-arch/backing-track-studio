{
  "name": "backing-track-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "app.pokeytivity.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "LESSONS", "id": "00c6361654234e1796f62d789486342c" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
